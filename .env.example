# Wzór konfiguracji backendu (Sebastian) i Docker Compose.
# Skopiuj do pliku .env w tym samym katalogu i uzupełnij wartości. Pliku .env NIE commitujemy.

# --- Aplikacja ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Adresy frontendu dopuszczone przez CORS, rozdzielone przecinkami (Vite domyślnie: port 5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL (kontener z docker-compose.yml) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=geomarket
MYSQL_USER=geomarket
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Konta i tokeny ---
# Sekret podpisu JWT, min. 32 znaki. Wygeneruj np.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Wymagany w production; lokalnie pusty = tymczasowy sekret (wylogowanie przy każdym restarcie).
JWT_SECRET_KEY=
# Ważność sesji logowania (minuty) i linku resetu hasła (minuty).
ACCESS_TOKEN_TTL_MINUTES=480
PASSWORD_RESET_TTL_MINUTES=15
# Adres frontendu wstawiany do linku resetu hasła: {FRONTEND_URL}/reset-password?token=...
FRONTEND_URL=http://localhost:5173
# Limity zapytań do endpointów kont (true/false).
RATE_LIMIT_ENABLED=true

# --- Resend: wysyłka e-maili z linkiem resetu hasła (https://resend.com) ---
# Puste w development: link resetu jest wypisywany w logach backendu zamiast wysyłki.
RESEND_API_KEY=
# Nadawca z domeny zweryfikowanej w Resend, np. GeoMarket <no-reply@twoja-domena.pl>
RESEND_FROM_EMAIL=

# --- Google reCAPTCHA v2 (rejestracja) ---
# Klucz witryny (publiczny) — trafia do frontendu w czasie budowania obrazu (VITE_RECAPTCHA_SITE_KEY).
# Po zmianie: docker compose build frontend. Musi być zarejestrowany w konsoli reCAPTCHA dla domen,
# z których działa frontend (localhost, domena Vercel/VPS).
RECAPTCHA_SITE_KEY=
# Klucz tajny z konsoli reCAPTCHA (nie udostępniać, nie commitować). Pusty = weryfikacja wyłączona.
# Ustawiony = pole "recaptcha_token" w POST /auth/register jest wymagane i sprawdzane w Google.
RECAPTCHA_SECRET_KEY=
# Tylko reCAPTCHA v3: minimalna ocena 0.0–1.0.
RECAPTCHA_MIN_SCORE=0.5

# --- Serwis AI Patryka (backend-ai) — adres wewnętrzny, przeglądarka się z nim nie łączy ---
AI_SERVICE_URL=http://127.0.0.1:8001
# Maksymalny czas oczekiwania na odpowiedź serwisu AI (sekundy; Gemini bywa wolny).
AI_TIMEOUT_SECONDS=60
# Świeżość odpowiedzi AI i newsów w cache bramki (sekundy).
AI_CACHE_TTL_SECONDS=600
NEWS_CACHE_TTL_SECONDS=300
# Jak długo trzymać ostatnią udaną odpowiedź na wypadek awarii serwisu AI (sekundy).
AI_STALE_MAX_AGE_SECONDS=86400
# Po błędzie połączenia z serwisem AI: pauza przed kolejną próbą (sekundy).
AI_RETRY_AFTER_SECONDS=15

# --- Dane rynkowe ---
# lakehouse = prawdziwe notowania z tabel Gold (wymaga działającego potoku: producent + konsument),
# test = dane testowe generowane w kodzie (np. do pracy nad frontendem bez Kafki).
MARKET_DATA_SOURCE=lakehouse
# Jak długo API trzyma w pamięci odczyt tabel Gold (sekundy).
MARKET_CACHE_SECONDS=15
# Długość serii na wykresach Giełdy i Makro (dni, punkty godzinowe).
CHART_HISTORY_DAYS=30

# --- Potok strumieniowy (Kafka z docker-compose.yml) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=geomarket-lakehouse
# Odpytywanie Yahoo Finance o świece minutowe (sekundy).
YAHOO_POLL_SECONDS=60
# CoinGecko: z darmowym kluczem demo limit to 10 000 zapytań/miesiąc → nie częściej niż co ~5 min.
COINGECKO_POLL_SECONDS=300
# Darmowy klucz demo z https://www.coingecko.com/en/api (opcjonalny; bez klucza limity są niższe).
COINGECKO_API_KEY=
# Odświeżanie liczby akcji spółek (do kapitalizacji), sekundy.
INSTRUMENT_INFO_REFRESH_SECONDS=86400
# Załadowanie historii (python -m app.stream.backfill): dni świec godzinowych (max 729).
HISTORY_DAYS=60
# Przy starcie producenta: świece godzinowe z tylu dni zasypują lukę po przerwie.
CATCH_UP_DAYS=5

# --- Lakehouse (Delta Lake) ---
# Wspólny katalog główny Lakehouse dla obu potoków. Domyślnie <repozytorium>/data/lakehouse
# (katalog data/ jest wykluczony z Gita). Patrz backend/docs/konwencja_lakehouse.md.
# LAKEHOUSE_ROOT=

# --- Docker Compose (cała platforma) ---
# Porty na komputerze (zmień, jeśli są zajęte).
API_PORT=8000
FRONTEND_PORT=5173
AI_PORT=8001
KAFKA_PORT=9092
KAFKA_UI_PORT=8090
# Publiczny adres API wpisywany do frontendu w czasie budowania obrazu (VPS: https://api.twoja-domena.pl).
PUBLIC_API_URL=http://localhost:8000
# Adres(y) reverse proxy, któremu API ufa w nagłówku X-Forwarded-For (VPS: adres proxy; * = każdy).
FORWARDED_ALLOW_IPS=127.0.0.1
