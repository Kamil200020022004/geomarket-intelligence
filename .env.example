# Wzór konfiguracji backendu (Sebastian) i Docker Compose.
# Skopiuj do pliku .env w tym samym katalogu i uzupełnij wartości. Pliku .env NIE commitujemy.

# --- Aplikacja ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Adresy frontendu dopuszczone przez CORS, rozdzielone przecinkami (Vite domyślnie: port 5173).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MySQL (kontener z docker-compose.yml) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=geomarket
MYSQL_USER=geomarket
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Lakehouse (Delta Lake) ---
# Wspólny katalog główny Lakehouse dla obu potoków. Domyślnie <repozytorium>/data/lakehouse
# (katalog data/ jest wykluczony z Gita). Patrz backend/docs/konwencja_lakehouse.md.
# LAKEHOUSE_ROOT=
